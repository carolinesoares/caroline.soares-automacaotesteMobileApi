{
  "name": "mobile-wdio-native-demo-app",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "npm run test:android",
    "test:api": "mocha --config .mocharc.api.cjs --reporter mocha-multi-reporters --reporter-options configFile=api-test/mocha-multi-reporters.json",
    "test:api:ci": "mocha --config .mocharc.api.cjs --reporter mocha-multi-reporters --reporter-options configFile=api-test/mocha-multi-reporters.ci.json",
    "test:android": "wdio run ./wdio.android.conf.js --spec ./test/specs/login.spec.js && wdio run ./wdio.android.conf.js --spec ./test/specs/forms.spec.js && wdio run ./wdio.android.conf.js --spec ./test/specs/navigation.spec.js",
    "test:ios": "wdio run ./wdio.ios.conf.js --spec ./test/specs/login.spec.js && wdio run ./wdio.ios.conf.js --spec ./test/specs/forms.spec.js && wdio run ./wdio.ios.conf.js --spec ./test/specs/navigation.spec.js",
    "test:bs": "wdio run ./wdio.browserstack.conf.js",
    "allure:generate": "allure generate ./allure-results --clean -o ./allure-report",
    "allure:open": "allure open ./allure-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@wdio/allure-reporter": "^9.27.0",
    "@wdio/appium-service": "^9.27.0",
    "@wdio/cli": "^9.27.0",
    "@wdio/local-runner": "^9.27.0",
    "@wdio/mocha-framework": "^6.1.17",
    "@wdio/spec-reporter": "^9.27.0",
    "allure-commandline": "^2.38.1",
    "allure-mocha": "^3.7.1",
    "appium": "^3.3.0",
    "appium-uiautomator2-driver": "^7.1.1",
    "appium-xcuitest-driver": "^10.43.0",
    "axios": "^1.15.0",
    "chai": "^4.5.0",
    "dotenv": "^16.4.7",
    "mocha": "^11.7.5",
    "mocha-multi-reporters": "^1.5.1",
    "mochawesome": "^7.1.4",
    "webdriverio": "^9.27.0"
  }
}
